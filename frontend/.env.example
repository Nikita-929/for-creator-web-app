# Base URL of the Spring Boot API.
#
# Leave EMPTY in local development — the Vite dev server proxies `/api/*` to
# http://localhost:8080 automatically (see vite.config.js).
#
# In production (Vercel / Netlify / a static host), set this to the public
# origin of the deployed API, for example:
#   VITE_API_URL=https://forcreators-api.onrender.com
VITE_API_URL=
