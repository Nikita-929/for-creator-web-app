# JWT signing secret — MUST change this in production to a long random string (32+ chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Spring profile: "dev" (H2 file database, no Docker needed) or "postgres" (real PostgreSQL)
SPRING_PROFILES_ACTIVE=dev
# SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL settings — used only when profile=postgres
# DATABASE_URL=jdbc:postgresql://localhost:5432/forcreators
# DATABASE_USER=forcreators
# DATABASE_PASSWORD=forcreators

# Razorpay payment gateway.
# Leave empty to run in demo / test-standalone mode (inventory still decrements on checkout).
# Get live / test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS — comma-separated list of frontend origins that may call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin inbox for contact-form and custom-order alert emails
ADMIN_NOTIFY_EMAIL=hello@forcreators.in

# SMTP server. Alerts fall back to a log line when SMTP is unreachable.
# For development, use MailHog / Mailpit on port 1025 with no auth.
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Local disk directory for uploaded product & review images.
# In production, swap StorageService for S3-compatible object storage.
UPLOAD_DIR=./uploads

# Newsletter list destination. Current values: "local" (stored in DB only).
# Future: "mailchimp", "convertkit", "brevo"
NEWSLETTER_PROVIDER=local

# Server port
PORT=8080
